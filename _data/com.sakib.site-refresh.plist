<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sakib.site-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/sakib/claude-experiments/sakib-site/_data/refresh.sh</string>
  </array>

  <!-- Mondays, 07:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/sakib/claude-experiments/sakib-site/_data/refresh.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/sakib/claude-experiments/sakib-site/_data/refresh.err</string>
</dict>
</plist>
